10 REM TABBASIC PONG - UP/DOWN OR A, SPACE RESTART, B TEXT EXIT
20 GRAPHICS:SPRITE 0,4,4
30 FOR I=0 TO 3:SPRITEROW 0,I,"1111":NEXT:SPRITESHOW 0
40 P=0:C=0:PY=90:CY=90:V=3:W=1:X=160:Y=100:K=0
50 IF KEY("B") THEN TEXT:END
60 IF KEY("SPACE") AND K=0 THEN P=0:C=0:X=160:Y=100:V=3:W=1
70 K=KEY("SPACE")
80 IF KEY("UP") OR KEY("A") THEN PY=PY-4
90 IF KEY("DOWN") THEN PY=PY+4
100 IF PY<26 THEN PY=26
110 IF PY>158 THEN PY=158
120 IF CY+14<Y THEN CY=CY+2
130 IF CY+14>Y THEN CY=CY-2
140 IF CY<26 THEN CY=26
150 IF CY>162 THEN CY=162
160 X=X+V:Y=Y+W
170 IF Y<26 THEN Y=26:W=ABS(W)
180 IF Y>186 THEN Y=186:W=-ABS(W)
190 IF X<18 AND X>8 AND V<0 AND Y+4>=PY AND Y<=PY+32 THEN 500
200 IF X>298 AND X<308 AND V>0 AND Y+4>=CY AND Y<=CY+28 THEN 550
210 IF X<0 THEN C=C+1:X=160:Y=100:V=3:W=1
220 IF X>316 THEN P=P+1:X=160:Y=100:V=-3:W=-1
230 CLS:COLOR 12:LINE 0,24,319,24:LINE 0,191,319,191
240 FOR I=30 TO 180 STEP 12:LINE 160,I,160,I+5:NEXT
250 COLOR 1:GTEXT 8,5,"PLAYER"+STR$(P)
260 GTEXT 225,5,"CPU"+STR$(C)
270 GTEXT 32,193,"UP DOWN - SPACE RESTART - B EXIT"
280 COLOR 3:RECT 12,PY,6,32,1:COLOR 7:RECT 302,CY,6,28,1
290 SPRITEPOS 0,X,Y:PRESENT:SLEEP 16:GOTO 50
500 X=18:V=ABS(V)+.2:IF V>6 THEN V=6
510 W=(Y-PY-14)/6:IF ABS(W)<.5 THEN W=1
520 GOTO 210
550 X=298:V=-ABS(V)-.2:IF V<-6 THEN V=-6
560 W=(Y-CY-12)/6:IF ABS(W)<.5 THEN W=-1
570 GOTO 210
