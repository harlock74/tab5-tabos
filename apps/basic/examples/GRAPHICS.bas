10 REM TABBASIC GRAPHICS DEMO - ARROWS MOVE, SPACE RETURNS TO TEXT
20 GRAPHICS:SPRITE 0,5,5
30 SPRITEROW 0,0,"..1..":SPRITEROW 0,1,".121."
40 SPRITEROW 0,2,"12321":SPRITEROW 0,3,".121."
50 SPRITEROW 0,4,"..1..":SPRITESHOW 0:X=160:Y=150
60 CLS:COLOR 1:GTEXT 8,8,"TABBASIC GRAPHICS - SPACE TO EXIT"
70 FOR I=0 TO 15:COLOR I:RECT I*20,25,20,15,1:NEXT
80 COLOR 2:LINE -10,50,319,90:COLOR 5:RECT 20,60,80,50
90 COLOR 4:CIRCLE 160,95,30:COLOR 7:CIRCLE 255,95,25,1
100 COLOR 1:PSET 160,95:GTEXT 8,185,"ARROWS MOVE THE SPRITE"
110 IF KEY("LEFT") THEN X=X-3
120 IF KEY("RIGHT") THEN X=X+3
130 IF KEY("UP") THEN Y=Y-3
140 IF KEY("DOWN") THEN Y=Y+3
150 IF X<0 THEN X=0
160 IF X>315 THEN X=315
170 IF Y<0 THEN Y=0
180 IF Y>180 THEN Y=180
190 SPRITEPOS 0,X,Y:PRESENT:SLEEP 16
200 IF KEY("SPACE") THEN TEXT:END
210 GOTO 60
