10 REM C64-STYLE DODGE - LEFT/RIGHT MOVE, B EXITS
20 PRINT "C64-STYLE DODGE":PRINT "LEFT/RIGHT MOVE, B EXITS"
30 INPUT "PRESS ENTER TO START";A$
40 FOR I=0 TO 62:POKE 832+I,0:NEXT
50 FOR I=0 TO 20:POKE 832+I*3,255:NEXT
60 POKE 2040,13:POKE 53249,160:POKE 53287,7:POKE 53269,1
70 POKE 53280,6:POKE 53281,0
80 POKE 54296,12:POKE 54272,214:POKE 54273,14
90 POKE 54277,8:POKE 54278,240:POKE 54276,17
100 X=140:OY=1:OX=INT(RND(1)*30)+4:S=0
110 A=1024+OY*40+OX:POKE A,32
120 IF KEY("B") THEN 300
130 IF KEY("LEFT") THEN X=X-4
140 IF KEY("RIGHT") THEN X=X+4
150 IF X<25 THEN X=25
160 IF X>245 THEN X=245
170 OY=OY+1
180 IF OY<22 THEN 220
190 IF ABS((20+OX*7)-X)<18 THEN 270
200 S=S+1:OY=1:OX=INT(RND(1)*30)+4
210 POKE 54272,100+(S AND 15)*8
220 A=1024+OY*40+OX:POKE A,81:POKE 55296+OY*40+OX,2
230 POKE 53248,X
240 FOR D=1 TO 30:NEXT:GOTO 110
270 POKE 54276,16:POKE 53269,0:TEXT
280 PRINT "GAME OVER. SCORE";S:END
300 POKE 54276,16:POKE 53269,0:TEXT
310 PRINT "SCORE";S:END
